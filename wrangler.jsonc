{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "kopilka-mini-app",
	"main": "worker.js",
	"compatibility_date": "2026-08-28",
	"compatibility_flags": ["nodejs_compat"],
	"vars": {
		"APP_URL": "https://kopilka-mini-app.kapysta105.workers.dev"
	},
	"triggers": {
		"crons": ["*/15 * * * *"]
	},
	"observability": {
		"enabled": true,
		"logs": {
			"head_sampling_rate": 1
		},
		"traces": {
			"enabled": true,
			"head_sampling_rate": 0.01
		}
	},
	"assets": {
		"directory": ".",
		"binding": "ASSETS",
		"run_worker_first": [
			"/api/*"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "kopilka-db",
			"database_id": "edf7bacd-cf5d-4ec0-b673-d7ce90efa699",
			"migrations_dir": "migrations",
			"remote": true
		}
	]
}
